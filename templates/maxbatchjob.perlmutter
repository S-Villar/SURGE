#!/bin/bash
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=1
#SBATCH --time=00:30:00
#SBATCH --mail-type=ALL
#SBATCH --qos=regular
#SBATCH -L SCRATCH
#SBATCH --constraint=cpu
#SBATCH -A mp288
#SBATCH -o M3DC1log.o%j
#SBATCH -e M3DC1log.e%j
#SBATCH --array=1-1
#SBATCH -J m3dc1_stability_max

set -euo pipefail

# Support manual array submission (skips bootstrap resubmit logic).
MANUAL_ARRAY="${MANUAL_ARRAY:-0}"

# Set M3DC1 MPI runner (srun for SLURM)
# The -n flag is added separately in the command, so this should just be "srun"
M3DC1_MPIRUN="${M3DC1_MPIRUN:-srun}"

# Set batch directory - use SLURM_SUBMIT_DIR (where sbatch was run) or environment variable
# SLURM_SUBMIT_DIR is set by SLURM to the directory where sbatch was executed
# This is more reliable than using the script location, which may be in /var/spool/slurmd
BATCH_DIR="${BATCH_DIR:-${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}}"

# Set up split_smb symlink in batch directory if it doesn't exist
# Use the split_smb from the M3DC1 build directory (same location as used in bin/ symlinks)
SPLIT_SMB_SOURCE="/global/cfs/cdirs/mp288/jinchen/PETSC/core-240527/upgrade-gnu850-pcpu/bin/split_smb"
SPLIT_SMB_LINK="${BATCH_DIR}/split_smb"
if [ ! -e "$SPLIT_SMB_LINK" ] || [ ! -L "$SPLIT_SMB_LINK" ]; then
    if [ -f "$SPLIT_SMB_SOURCE" ]; then
        ln -sf "$SPLIT_SMB_SOURCE" "$SPLIT_SMB_LINK"
        echo "Created symlink: $SPLIT_SMB_LINK -> $SPLIT_SMB_SOURCE"
    else
        echo "WARNING: split_smb source not found at $SPLIT_SMB_SOURCE"
        echo "WARNING: Will try to use split_smb from PATH"
    fi
fi
# Add batch directory to PATH so split_smb symlink is accessible
export PATH="${BATCH_DIR}:${PATH}"

# Ensure m3dc1_2d_complex executable is available via symlink
M3DC1_BIN_SOURCE="/global/homes/a/asvillar/src/M3DC1/unstructured/_perlmutter_cpu_gcc-complex-opt-25/m3dc1_2d_complex"
M3DC1_BIN_LINK="${BATCH_DIR}/m3dc1_2d_complex"
if [ ! -e "$M3DC1_BIN_LINK" ] || [ ! -L "$M3DC1_BIN_LINK" ]; then
    if [ -x "$M3DC1_BIN_SOURCE" ]; then
        ln -sf "$M3DC1_BIN_SOURCE" "$M3DC1_BIN_LINK"
        echo "Created symlink: $M3DC1_BIN_LINK -> $M3DC1_BIN_SOURCE"
    else
        echo "ERROR: m3dc1_2d_complex not found or not executable at $M3DC1_BIN_SOURCE"
        exit 1
    fi
fi

# If this is the initial submission (array size 1-1), compute array size and resubmit
# Check if we're in the bootstrap phase by looking at SLURM_ARRAY_TASK_MAX
if [ "$MANUAL_ARRAY" != "1" ] && [ -n "${SLURM_ARRAY_TASK_MAX:-}" ] && [ "$SLURM_ARRAY_TASK_MAX" -eq 1 ]; then
    # Count number of runs
    RUN_DIRS=($(find "$BATCH_DIR" -maxdepth 1 -type d -name "run[0-9]*" | sort -V))
    N_RUNS=${#RUN_DIRS[@]}
    
    if [ "$N_RUNS" -eq 0 ]; then
        echo "ERROR: No run directories found in $BATCH_DIR"
        exit 1
    fi
    
    # Count number of equilibria by checking run1 (first run)
    RUN1_DIR="${BATCH_DIR}/run1"
    if [ ! -d "$RUN1_DIR" ]; then
        echo "ERROR: run1 directory not found in $BATCH_DIR"
        exit 1
    fi
    
    # Sort equilibria directories numerically by the number part (sparc_XXXX)
    # This handles cases like sparc_1300, sparc_234321, sparc_1301 correctly
    # Extract number, sort numerically, then return full paths
    EQUILIBRIA_DIRS=($(find "$RUN1_DIR" -maxdepth 1 -type d -name "sparc_*" -exec bash -c 'echo "$(basename "$1" | sed "s/sparc_//") $1"' _ {} \; | sort -n | awk '{print $2}'))
    N_EQUILIBRIA=${#EQUILIBRIA_DIRS[@]}
    
    if [ "$N_EQUILIBRIA" -eq 0 ]; then
        echo "ERROR: No sparc_* equilibrium directories found in $RUN1_DIR"
        exit 1
    fi
    
    TOTAL_CASES=$((N_RUNS * N_EQUILIBRIA))
    
    # Determine queue type and set SLURM array limit accordingly
    # Check SBATCH directive (from script header) or SLURM environment variable
    QOS="${SLURM_JOB_QOS:-regular}"
    if grep -q "^#SBATCH.*qos.*debug" "$0" 2>/dev/null || [ "$QOS" = "debug" ]; then
        MAX_ARRAY_SIZE=5
        QOS_TYPE="debug"
    else
        MAX_ARRAY_SIZE=4950
        QOS_TYPE="regular"
    fi
    
    ARRAY_SIZE=$TOTAL_CASES
    if [ "$TOTAL_CASES" -gt "$MAX_ARRAY_SIZE" ]; then
        ARRAY_SIZE=$MAX_ARRAY_SIZE
        echo "WARNING: Total cases ($TOTAL_CASES) exceeds SLURM array limit for $QOS_TYPE queue ($MAX_ARRAY_SIZE)"
        echo "WARNING: Only cases 1-$MAX_ARRAY_SIZE will be submitted in this launch."
        echo "WARNING: Use completebatchjob.perlmutter after this array finishes to queue remaining cases."
    fi
    
    echo "Batch directory: $BATCH_DIR"
    echo "Number of runs: $N_RUNS"
    echo "Number of equilibria per run: $N_EQUILIBRIA"
    echo "Total cases: $TOTAL_CASES"
    echo "Queue type: $QOS_TYPE (detected QOS: $QOS)"
    echo "Array size: $ARRAY_SIZE (SLURM limit for $QOS_TYPE queue: $MAX_ARRAY_SIZE)"
    echo "Resubmitting with array size: 1-$ARRAY_SIZE"
    
    # Resubmit with the correct array size
    sbatch --array=1-$ARRAY_SIZE "$0"
    exit 0
fi

# If we get here, we're running as part of the job array
# Continue with normal job execution

# Count number of equilibria by checking run1 (first run)
RUN1_DIR="${BATCH_DIR}/run1"
# Sort equilibria directories numerically by the number part (sparc_XXXX)
# This handles cases like sparc_1300, sparc_234321, sparc_1301 correctly
# Extract number, sort numerically, then return full paths
EQUILIBRIA_DIRS=($(find "$RUN1_DIR" -maxdepth 1 -type d -name "sparc_*" -exec bash -c 'echo "$(basename "$1" | sed "s/sparc_//") $1"' _ {} \; | sort -n | awk '{print $2}'))
N_EQUILIBRIA=${#EQUILIBRIA_DIRS[@]}

if [ "$N_EQUILIBRIA" -eq 0 ]; then
    echo "ERROR: No sparc_* equilibrium directories found in $RUN1_DIR"
    exit 1
fi

# Compute run and equilibrium IDs from SLURM_ARRAY_TASK_ID
# caseID = (runID-1)*n_equilibria + equilibriumID
# So: runID = ((caseID-1) // n_equilibria) + 1
#     equilibriumID = ((caseID-1) % n_equilibria) + 1
CASE_ID=$SLURM_ARRAY_TASK_ID
RUN_ID=$(( (CASE_ID - 1) / N_EQUILIBRIA + 1 ))
EQ_ID=$(( (CASE_ID - 1) % N_EQUILIBRIA + 1 ))

# Get equilibrium case name (sorted numerically by sparc number)
EQ_DIR="${BATCH_DIR}/run${RUN_ID}"
# Sort equilibria directories numerically by the number part (sparc_XXXX)
# This ensures consistent ordering: sparc_1300 < sparc_1301 < sparc_234321
# Extract number, sort numerically, then return full paths
CASE_DIRS=($(find "$EQ_DIR" -maxdepth 1 -type d -name "sparc_*" -exec bash -c 'echo "$(basename "$1" | sed "s/sparc_//") $1"' _ {} \; | sort -n | awk '{print $2}'))

if [ ${#CASE_DIRS[@]} -eq 0 ]; then
    echo "ERROR: No sparc_* directories found in $EQ_DIR"
    exit 1
fi

if [ ${#CASE_DIRS[@]} -ne "$N_EQUILIBRIA" ]; then
    echo "WARNING: Run $RUN_ID has ${#CASE_DIRS[@]} equilibria, expected $N_EQUILIBRIA"
fi

CASE_DIR="${CASE_DIRS[$((EQ_ID - 1))]}"

if [ ! -d "$CASE_DIR" ]; then
    echo "ERROR: Case directory not found: $CASE_DIR"
    exit 1
fi

cd "$CASE_DIR"

echo "Case ID: $CASE_ID, Run: $RUN_ID, Equilibrium: $EQ_ID, Directory: $CASE_DIR"
echo "pwd: $(pwd)"

touch started

# Partition mesh and run M3DC1 for this case
RUN_DIR=$(dirname "$CASE_DIR")
MESH_DIR="${RUN_DIR}/mesh"
MESH_READY_FLAG="${RUN_DIR}/.mesh_ready"
CASE_PREFIX="[case ${CASE_ID} | run ${RUN_ID} | eq ${EQ_ID}]"

mkdir -p "$MESH_DIR"

echo "${CASE_PREFIX} Step 1/3: locating mesh source ..."
MESH_SRC=$(find "$CASE_DIR" -maxdepth 1 -name "sparc_fw1-18K*.smb" | sort | head -1)
if [ -z "$MESH_SRC" ]; then
    echo "${CASE_PREFIX} ERROR: mesh source sparc_fw1-18K*.smb not found in $CASE_DIR"
    exit 1
fi
if [ ! -s "$MESH_SRC" ]; then
    echo "${CASE_PREFIX} ERROR: mesh source $MESH_SRC exists but is empty"
    exit 1
fi

MESH_FILE=$(basename "$MESH_SRC")
MESH_BASE="${MESH_FILE%.smb}"
MESH_BASE=$(echo "$MESH_BASE" | sed 's/[0-9]*$//')
MESH_BASE_NAME="${MESH_BASE}.smb"
RUN_MESH_SRC="${RUN_DIR}/${MESH_FILE}"
RUN_MESH_BASE="${RUN_DIR}/${MESH_BASE_NAME}"
CASE_MESH_BASE="${CASE_DIR}/${MESH_BASE_NAME}"

echo "${CASE_PREFIX}   mesh file: $MESH_SRC"
echo "${CASE_PREFIX}   mesh base name: $MESH_BASE_NAME"

echo "${CASE_PREFIX} Step 1a: refreshing mesh symlinks ..."
if [ ! -f "$RUN_MESH_SRC" ]; then
    cp -fp "$MESH_SRC" "$RUN_MESH_SRC"
elif [ "$MESH_SRC" -nt "$RUN_MESH_SRC" ]; then
    cp -fp "$MESH_SRC" "$RUN_MESH_SRC"
fi
ln -sf "$RUN_MESH_SRC" "$RUN_DIR/$MESH_BASE_NAME"
ln -sf "$RUN_MESH_SRC" "$CASE_DIR/$MESH_FILE"
ln -sf "$RUN_DIR/$MESH_BASE_NAME" "$CASE_DIR/$MESH_BASE_NAME"
ls -l "$RUN_MESH_SRC" "$RUN_DIR/$MESH_BASE_NAME" "$CASE_DIR/$MESH_FILE" "$CASE_DIR/$MESH_BASE_NAME"

echo "${CASE_PREFIX} Step 2/3: mesh partitioning ..."
if [ ! -f "${MESH_DIR}/part0.smb" ] || [ ! -f "$MESH_READY_FLAG" ]; then
    echo "${CASE_PREFIX}   partition target: $MESH_DIR/part.smb"
    rm -f "${MESH_DIR}"/part*.smb 2>/dev/null || true
    pushd "$RUN_DIR" >/dev/null
    echo "${CASE_PREFIX}   running split_smb with $SLURM_NTASKS ranks"
    set -x
    $M3DC1_MPIRUN -n $SLURM_NTASKS split_smb "$MESH_BASE_NAME" "mesh/part.smb" $SLURM_NTASKS
    set +x
    popd >/dev/null

    if [ ! -f "${MESH_DIR}/part0.smb" ]; then
        echo "${CASE_PREFIX} ERROR: partitioning failed; part0.smb missing in $MESH_DIR"
        ls -l "$MESH_DIR" || true
        exit 1
    fi
    touch "$MESH_READY_FLAG"
    echo "${CASE_PREFIX}   partitioning finished; parts available in $MESH_DIR"
else
    echo "${CASE_PREFIX}   mesh already partitioned; reusing existing parts"
fi

if [ ! -f "${MESH_DIR}/part0.smb" ]; then
    echo "${CASE_PREFIX} ERROR: mesh partitions still missing after split_smb"
    exit 1
fi

if [ "$EQ_ID" -ne 1 ] && [ ! -f "$MESH_READY_FLAG" ]; then
    echo "${CASE_PREFIX} waiting for mesh_ready flag ..."
    while [ ! -f "$MESH_READY_FLAG" ]; do
        sleep 1
    done
fi

ls -l "${MESH_DIR}"/part*.smb | head -5

echo "${CASE_PREFIX} Step 3/3: launching M3DC1 ..."
LOG_OUT="${CASE_DIR}/M3DC1log.o"
LOG_ERR="${CASE_DIR}/M3DC1log.e"
rm -f "$LOG_OUT" "$LOG_ERR"
set -x
$M3DC1_MPIRUN -n $SLURM_NTASKS m3dc1_2d_complex -pc_factor_mat_solver_type mumps >"$LOG_OUT" 2>"$LOG_ERR"
set +x
echo "${CASE_PREFIX} M3DC1 completed"

C1_OUTPUT="${CASE_DIR}/C1.h5"
if [ -f "$C1_OUTPUT" ]; then
    echo "${CASE_PREFIX} SUCCESS: found C1.h5 at $C1_OUTPUT"
    ls -l "$C1_OUTPUT"
else
    echo "${CASE_PREFIX} WARNING: C1.h5 not found in $CASE_DIR"
    ls -l "$CASE_DIR" | head -20
fi

ls -l "$CASE_DIR"/time_*.h5 2>/dev/null | head -5 || true

touch finished

STD_SLURM_OUT="${BATCH_DIR}/M3DC1log.o${SLURM_JOB_ID}"
STD_SLURM_ERR="${BATCH_DIR}/M3DC1log.e${SLURM_JOB_ID}"
if [ -f "$STD_SLURM_OUT" ]; then
    mv "$STD_SLURM_OUT" "${CASE_DIR}/"
fi
if [ -f "$STD_SLURM_ERR" ]; then
    mv "$STD_SLURM_ERR" "${CASE_DIR}/"
fi

